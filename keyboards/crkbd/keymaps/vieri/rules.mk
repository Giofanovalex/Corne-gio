# Enable features for the Corne keyboard
OLED_ENABLE = yes
RGBLIGHT_ENABLE = no
WPM_ENABLE = yes

# Nonaktifkan fitur-fitur yang tidak dipakai untuk menghemat memori bagi animasi
MOUSEKEY_ENABLE = no
EXTRAKEY_ENABLE = no

# Enable Link-Time Optimization to significantly reduce firmware size
# This prevents the Pro Micro (ATmega32U4) from running out of flash memory.
LTO_ENABLE = yes
